# boxai-chat edge routing (include inside the you-box.com server block).
#
# /chat-api/* is the agent chat stream; the trailing slash on proxy_pass
# strips the prefix so the service sees /v1/chat. Buffering must stay off
# for SSE.
location /chat-api/ {
    proxy_pass http://127.0.0.1:3100/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

# Conversation, memory, and persona clients use the /chat-api/api/playground/*
# namespace above. Do not add overlapping /api/playground/* proxy locations:
# the remaining gateway routes own assets and Studio projects.
